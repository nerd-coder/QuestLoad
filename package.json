{
  "name": "questload",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "preview": "bun run --cwd apps/web preview",
    "dev:brand": "bun run --cwd apps/brand dev",
    "build:brand": "bun run --cwd apps/brand build",
    "credentials": "bun scripts/credentials/main.ts",
    "check": "bun run lint && bun run typecheck && bun run build && bun run build:brand",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts && bun run --cwd apps/brand typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web": "^0.0.256",
    "typescript": "^7.0.0",
    "vite": "^7.3.1",
    "wrangler": "^4.129.0"
  }
}
